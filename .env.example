# ClipMaster Processor — environment template.
# Copy to .env for local dev. NEVER commit a real .env with keys.

# Port the server listens on (Render sets PORT automatically).
PORT=10000

# Optional. When set, every /api/process/* call must send:
#   Authorization: Bearer <PROCESSING_API_KEY>
# When unset, the endpoints are unauthenticated.
# IMPORTANT: use the SAME value here and in Vercel (PROCESSING_API_KEY).
PROCESSING_API_KEY=

# Required for /api/process/transcribe (Groq Whisper, free tier).
# Get one at https://console.groq.com/keys — no card needed.
GROQ_API_KEY=

# Whisper model used for transcription (default: whisper-large-v3-turbo).
GROQ_MODEL=whisper-large-v3-turbo

# Limits (defaults are tuned for Render's free tier: 512 MB RAM, 0.1 CPU).
MAX_UPLOAD_MB=500
MAX_DOWNLOAD_MB=500
MAX_CLIP_SECONDS=300
PROBE_TIMEOUT_MS=60000
THUMBNAIL_TIMEOUT_MS=120000
RENDER_TIMEOUT_MS=600000
TRANSCRIBE_TIMEOUT_MS=300000
DOWNLOAD_TIMEOUT_MS=120000
